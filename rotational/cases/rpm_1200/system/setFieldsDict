FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Initial condition: well filled with water up to z = 0.00275 m
// (96.3 microlitres), air above.

defaultFieldValues
(
    volScalarFieldValue alpha.water 0
);

regions
(
    boxToCell
    {
        box (-0.007 -0.007 -1) (0.007 0.007 0.00275);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
        );
    }
);

