#!/bin/sh
# Runs this case: pre-processing (if not done yet) + parallel interFoam.
# Number of processes = numberOfSubdomains in system/decomposeParDict.
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------

[ -d constant/polyMesh ] || ./Allrun.pre

[ -d processor0 ] || runApplication decomposePar

# The full solver log would reach hundreds of MB, so only one time step in
# every 200 is kept, plus all warnings and errors.
app=$(getApplication)
np=$(getNumberOfProcessors)
echo "Running $app in parallel on $PWD using $np processes"
mpirun -np $np $app -parallel 2>&1 | awk '/^Courant Number mean/{n++} /FOAM FATAL/{f=1} f || n%200==1 || /Warning/ {print; fflush()}' > log.$app

runApplication reconstructPar

#------------------------------------------------------------------------------
