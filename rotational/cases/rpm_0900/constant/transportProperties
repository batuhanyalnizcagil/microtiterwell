FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Water and air at room temperature (20 degC)

phases          (water air);

water
{
    transportModel  Newtonian;
    nu              1.004e-06;
    rho             998.2;
}

air
{
    transportModel  Newtonian;
    nu              1.516e-05;
    rho             1.204;
}

sigma           0.0728;


