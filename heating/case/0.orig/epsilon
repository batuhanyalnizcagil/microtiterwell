FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Carrier of the vapour diffusivity only - see constant/fvOptions.

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 3.46154e-05;

boundaryField
{
    bottom
    {
        type            zeroGradient;
    }

    sideWall
    {
        type            zeroGradient;
    }

    top
    {
        type            zeroGradient;
    }

    front
    {
        type            wedge;
    }

    back
    {
        type            wedge;
    }
}

