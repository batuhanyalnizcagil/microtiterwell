FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Water in the lower half of the well, humid air above.

defaultFieldValues
(
    volScalarFieldValue alpha.gas       1
    volScalarFieldValue alpha.liquid    0
    volScalarFieldValue k               0.0001
    volScalarFieldValue epsilon         3.46154e-05
);

regions
(
    boxToCell
    {
        box (-1 -1 -1) (1 1 0.00545);
        fieldValues
        (
            volScalarFieldValue alpha.liquid    1
            volScalarFieldValue alpha.gas       0
            volScalarFieldValue k               1e-10
            volScalarFieldValue epsilon         0.001
        );
    }
);

