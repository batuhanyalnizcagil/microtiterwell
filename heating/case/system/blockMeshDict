FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// 2-D axisymmetric wedge (5 deg) of the conical well.
// z = well axis (vertices 0-1), x = radial direction; the wedge is one cell
// thick in the circumferential direction.
// Block directions: 1st = axial, 2nd = radial. Cells are therefore numbered
// axial-first, then radial (the Python post-processing relies on this - do
// not run renumberMesh). If you change the geometry or the cell counts, also
// update caseInfo.txt (read by the post-processing).

scale   1;

mergeType points;   // wedge: collapse the edge on the axis

vertices
(
    (0 0 0)    // 0
    (0 0 0.0109)    // 1
    (0.003315 -0.000144736026 0)    // 2
    (0.0035 -0.0001528133 0.0109)    // 3
    (0.003315 0.000144736026 0)    // 4
    (0.0035 0.0001528133 0.0109)    // 5
);

blocks
(
    hex (0 1 3 2 0 1 5 4) (78 24 1) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    bottom
    {
        type wall;
        faces ((0 2 4 0));
    }

    sideWall
    {
        type wall;
        faces ((2 3 5 4));
    }

    top
    {
        type wall;
        faces ((1 3 5 1));
    }

    front
    {
        type wedge;
        faces ((0 1 3 2));
    }

    back
    {
        type wedge;
        faces ((0 4 5 1));
    }
);

mergePatchPairs
(
);

