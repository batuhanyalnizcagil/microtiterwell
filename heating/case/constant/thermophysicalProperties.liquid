FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties.liquid;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Water. Density varies linearly with temperature (drives natural convection).

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState Boussinesq;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        nMoles          1;
        molWeight       18.015;
    }
    equationOfState
    {
        rho0            998.2;
        T0              293.15;
        beta            0.00032;
    }
    thermodynamics
    {
        Cp              4180;
        Hf              -2.43e+06;     // -(latent heat) [J/kg]
    }
    transport
    {
        mu              0.00077;
        Pr              5.217;      // -> conductivity 0.617 W/m/K
    }
}

