FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The flow is laminar. The k-epsilon model is NOT used to model turbulence:
// k and epsilon are held constant (constant/fvOptions) so that
// nut = Cmu*k^2/epsilon provides the molecular diffusivity of water vapour
// in the gas, which the solver otherwise does not include.

simulationType  RAS;

RAS
{
    RASModel        kEpsilon;
    turbulence      on;
    printCoeffs     on;
}

