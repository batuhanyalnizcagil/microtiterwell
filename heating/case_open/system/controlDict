FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     icoReactingMultiphaseInterFoam;

startFrom       latestTime;     // allows restarting an interrupted run

startTime       0;

stopAt          endTime;

endTime         450;

deltaT          1e-05;

writeControl    adjustable;

writeInterval   5;

purgeWrite      0;

writeFormat     ascii;          // read directly by postprocess_heating.py

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.5;
maxAlphaCo      0.5;
maxAlphaDdt     1;

// Explicit surface tension is only stable below the capillary time step
// sqrt(rho_avg*dx^3/(2*pi*sigma)) = 0.000537 s for this mesh (dx = 0.000138 m).
// The flow itself is very slow, so this limit sets the time step.
maxDeltaT       0.000483;

