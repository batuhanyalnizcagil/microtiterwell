FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      vapour.gas;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Mass fraction of water vapour in the gas phase.
// Initial value = 50 % relative humidity at 293.15 K.
// top (open): room air at 50 % relative humidity. A fixed value (not
// inletOutlet) so that vapour can leave the well by diffusion.

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.00713213;

boundaryField
{
    bottom
    {
        type            zeroGradient;
    }

    sideWall
    {
        type            zeroGradient;
    }

    top
    {
        type            fixedValue;
        value           uniform 0.00713213;
    }

    front
    {
        type            wedge;
    }

    back
    {
        type            wedge;
    }
}

// ************************************************************************* //
